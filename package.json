{
  "name": "dsh-remote-switch",
  "version": "0.2.6",
  "description": "Two remote-instance surfaces for DeepSeek Harness: a switcher that opens another DSH instance in a new window from a sidebar entry, and a read-only sidebar panel listing another machine's sessions and running state over SSH or HTTP.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "instance",
    "switcher",
    "remote",
    "federation",
    "ssh"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1"
  },
  "scripts": {
    "verify:host": "node scripts/verify-host.mjs",
    "verify:client": "node scripts/verify-client.mjs",
    "verify:federation": "node scripts/verify-federation.mjs",
    "verify:provision": "node scripts/verify-provision-e2e.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "test-instance": "pwsh -File scripts/test-instance.ps1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hunter53323/dsh-remote-switch.git"
  },
  "homepage": "https://github.com/Hunter53323/dsh-remote-switch#readme",
  "bugs": {
    "url": "https://github.com/Hunter53323/dsh-remote-switch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "ws": "^8.21.3"
  }
}
