{
  "name": "dsh-remote-switch",
  "version": "0.1.0",
  "description": "Instance switcher for DeepSeek Harness: keep a list of DSH instances and open any of them in a new window from a sidebar entry, so the page you are on (and its switcher) survives the switch.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "instance",
    "switcher",
    "remote"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1"
  },
  "scripts": {
    "verify:host": "node scripts/verify-host.mjs",
    "verify:client": "node scripts/verify-client.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hunter53323/dsh-remote-switch.git"
  },
  "homepage": "https://github.com/Hunter53323/dsh-remote-switch#readme",
  "bugs": {
    "url": "https://github.com/Hunter53323/dsh-remote-switch/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
